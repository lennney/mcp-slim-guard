{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lennney/mcp-slim-guard/schemas/evaluation-report-v1.json",
  "title": "MCP Slim Guard evaluation report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate",
    "suite",
    "environment",
    "methodology",
    "observations",
    "comparisons",
    "hard_gates",
    "verdict",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "digest", "package_version"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/sha256" },
        "package_version": { "type": "string", "minLength": 1 },
        "git_head": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
        "dirty": { "type": "boolean" },
        "file_count": { "type": "integer", "minimum": 1 }
      }
    },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "id", "kind", "manifest_sha256", "fixture_sha256", "case_count", "profiles"],
      "properties": {
        "schema_version": { "const": 1 },
        "id": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": [
            "protocol-replay",
            "result-projection",
            "selective-retrieval",
            "tool-retrieval",
            "stress",
            "host-task"
          ]
        },
        "manifest_sha256": { "$ref": "#/$defs/sha256" },
        "fixture_sha256": { "$ref": "#/$defs/sha256" },
        "case_count": { "type": "integer", "minimum": 1 },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "corpus_sha256": { "$ref": "#/$defs/sha256" },
        "pool_sizes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "platform", "arch", "tokenizer"],
      "properties": {
        "node": { "type": "string", "minLength": 1 },
        "platform": { "type": "string", "minLength": 1 },
        "arch": { "type": "string", "minLength": 1 },
        "tokenizer": { "type": "string", "minLength": 1 },
        "host": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "model"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "model": { "type": "string", "minLength": 1 },
            "reasoning_effort": { "type": "string", "minLength": 1 },
            "config_digest": { "$ref": "#/$defs/sha256" }
          }
        }
      }
    },
    "methodology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "adapter", "accounting", "exact_recovery", "upstream_call_accounting", "limitation"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "adapter": { "type": "string", "minLength": 1 },
        "accounting": { "type": "string", "minLength": 1 },
        "exact_recovery": { "type": "string", "minLength": 1 },
        "upstream_call_accounting": { "type": "string", "minLength": 1 },
        "limitation": { "type": "string", "minLength": 1 }
      }
    },
    "observations": {
      "type": "array",
      "items": { "type": "object" }
    },
    "comparisons": { "type": "object" },
    "hard_gates": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/gate" }
    },
    "verdict": { "enum": ["pass", "fail", "inconclusive"] },
    "summary": { "type": "object" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "expected", "actual"],
      "properties": {
        "passed": { "type": "boolean" },
        "expected": {},
        "actual": {}
      }
    }
  }
}
